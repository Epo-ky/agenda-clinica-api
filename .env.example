DB_URL=jdbc:postgresql://localhost:5432/agenda_clinica
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres). Gere um aleatório.
