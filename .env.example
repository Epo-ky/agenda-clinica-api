# Admin criado na primeira subida (só se ainda não existir nenhum ADMIN). Senha com pelo menos 8 caracteres.
ADMIN_EMAIL=admin@agendaclinica.com
ADMIN_PASSWORD=troque-esta-senha-do-admin
